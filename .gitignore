# ==============================================================================
# DaneshMate Monorepo .gitignore
# Covers Rust (Embedded Native C-ABI Library), React Native / Expo, Android, iOS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Rust & Cargo Build Artifacts
# ------------------------------------------------------------------------------
/backend/target/
target/
**/*.rs.bk
*.pdb
*.dSYM/
Cargo.lock.backup
backend/.cargo/

# ------------------------------------------------------------------------------
# 2. Node.js & Dependency Packages
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.npm/
.yarn/
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. React Native & Expo Engine
# ------------------------------------------------------------------------------
.expo/
.expo-shared/
web-build/
dist/
build/
artifacts/

# Keystores & Certificates (Strictly Excluded)
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
RELEASE_KEYSTORE_BASE64.txt
RELEASE_CREDENTIALS.txt
KEYSTORE_INFO.txt
daneshmate-release.jks

# ------------------------------------------------------------------------------
# 4. Android Native Platform
# ------------------------------------------------------------------------------
.gradle/
**/android/.gradle/
**/android/build/
**/android/app/build/
**/android/local.properties
**/android/**/*.iml
**/android/.cxx/
**/android/.idea/
**/android/app/src/main/assets/index.android.bundle
**/android/app/src/main/res/raw/
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json

# ------------------------------------------------------------------------------
# 5. iOS Native Platform & CocoaPods
# ------------------------------------------------------------------------------
**/ios/Pods/
**/ios/build/
**/ios/DerivedData/
**/ios/*.xcworkspace/
**/ios/*.xcodeproj/xcuserdata/
**/ios/*.xcodeproj/project.xcworkspace/xcuserdata/
**/ios/*.mode1v3
**/ios/*.mode2v3
**/ios/*.perspectivev3

# ------------------------------------------------------------------------------
# 6. Environment Variables & Credentials
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# ------------------------------------------------------------------------------
# 7. OS Caches & Editor Settings
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Visual Studio Code & JetBrains IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
