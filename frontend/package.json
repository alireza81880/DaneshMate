{
  "name": "daneshmate-mobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file App.tsx --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:android:aab": "eas build --platform android --profile production",
    "prebuild": "expo prebuild --clean",
    "generate:assets": "node scripts/generate_assets.js",
    "export:web": "expo export -p web",
    "export:release": "expo export --platform android"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-status-bar": "~1.12.1",
    "expo-haptics": "~13.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/config-plugins": "~8.0.0",
    "@expo/metro-config": "~0.18.8",
    "@types/react": "~18.2.45",
    "babel-preset-expo": "~11.0.0",
    "typescript": "^5.1.3"
  },
  "private": true
}
